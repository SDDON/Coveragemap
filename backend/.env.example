# Neo4j Database Connection (Supports both Docker and native binary)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# [Optional] Local Neo4j Installation Path (if not automatically discovered)
# NEO4J_HOME=E:\neo4j-community-2026.02.2

# Backend Port (Default: 8190)
PORT=8190
