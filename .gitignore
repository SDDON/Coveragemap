# ──────────────────────────────────────────────
# CoverageMap .gitignore
# ──────────────────────────────────────────────

# Environment files (secrets)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Node.js
node_modules/
dist/
dist-ssr/
*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
test-results/
playwright-report/

# Build artifacts
*.tsbuildinfo

# OS generated
.DS_Store
Thumbs.db

# Temporary / scratch files
*.tmp
*.bak
scratch/
