# ──────────────────────────────────────────────
# CoverageMap .gitignore
# ──────────────────────────────────────────────

# Environment files (secrets)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Node.js
node_modules/
dist/
dist-ssr/
*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
test-results/
playwright-report/

# Build artifacts
*.tsbuildinfo

# OS generated
.DS_Store
Thumbs.db

# Temporary / scratch files
*.tmp
*.bak
scratch/

# 사용자 생성 프리셋 및 파괴적 작업 전 자동 백업 프리셋 무시 (샘플 프리셋 4종만 버전 관리)
backend/presets/*.json
!backend/presets/honkai_starrail_full_qa.json
!backend/presets/honkai_starrail_title.json
!backend/presets/minimal_e2e.json
!backend/presets/mobile_game_qa_guide_2026_10.json

# Multi-agent orchestration working directory (워크스페이스 공유 스킬만 버전 관리)
.agents/*
!.agents/skills/
