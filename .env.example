# ========================================================
# CoverageMap Environment Variables
# ========================================================

# [Optional] Local Neo4j Directory (Used by run_db.bat for smart auto-discovery)
# Example: NEO4J_HOME=E:\neo4j-community-2026.02.2
# If omitted, run_db.bat will auto-detect from PATH and drives (C, D, E)
# NEO4J_HOME=

# Backend Port (Default: 8190)
BACKEND_PORT=8190
